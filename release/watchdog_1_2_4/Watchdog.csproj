<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyName>AIRE_Watchdog</AssemblyName>
    <AssemblyTitle>AIRE Watchdog</AssemblyTitle>
    <Description>Supervision de Ilsan Packing System</Description>
    <Company>Ilsan</Company>
    <Product>Ilsan Packing System</Product>
    <Version>1.2.4</Version>
    <FileVersion>1.2.4.0</FileVersion>
    <AssemblyVersion>1.2.4.0</AssemblyVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
